# GROQ API CONFIGURATION
# ========================
# This is an example configuration file.
# Copy this file to .env.local and add your actual API key.

# Your Groq API Key (REQUIRED)
# Get your key from: https://console.groq.com/keys
# The key should start with 'gsk_'
GROQ_API_KEY=gsk_your_actual_api_key_here

# API Base URL (OPTIONAL)
# Only change this if you're using a custom endpoint
# Default: https://api.groq.com/openai/v1
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# IMPORTANT NOTES:
# ================
# 1. Never commit your actual API key to version control
# 2. The .env.local file should be in your .gitignore
# 3. Restart your development server after adding/changing the key
# 4. The API key must be valid and have the necessary permissions
# 5. Test your setup by visiting: http://localhost:3000/api/test
